{
  "name": "rich_s4_preview_catalog_gate",
  "description": "Rich S4 catalog-aware preview gate; validates active UT/GW/zone catalogs and selector expansion before runtime.",
  "runner": "starlink_shell_experiment",
  "planned_shell": "S4",
  "max_satellites": 348,
  "catalog_contract": {
    "required": true,
    "forbid_hidden_legacy_defaults": true
  },
  "validation_selector": {
    "ut": {
      "mode": "catalog-derived-first-n",
      "count": 32
    },
    "gateway": {
      "mode": "catalog-derived-first-n",
      "count": 12
    },
    "zone": {
      "mode": "catalog-all"
    }
  },
  "runner_args": {
    "run_mode": "preview",
    "orbit_input_mode": "planned-shell",
    "planned_shell_id": "S4",
    "max_satellites": 348,
    "ut_catalog": "satellite/configs/starlink_shell_ground/s4_gz_rich_validation_ut_catalog_32.json",
    "gateway_catalog": "satellite/configs/starlink_shell_ground/realistic_preview_gateway_catalog_12.json",
    "zone_catalog": "satellite/configs/starlink_shell_ground/s4_gz_rich_validation_zone_catalog_16.json",
    "max_uts": 32,
    "max_gateways": 12,
    "ground_placement": "shell-aware",
    "sample_interval": 10,
    "event_evaluation_interval": 10,
    "horizon_seconds": 120,
    "runtime_mode": "operational_clean",
    "max_runtime_epochs": 4,
    "max_parameter_epochs": 1,
    "runtime_epoch_validation_scope": "reapplied_gateway_class_sample",
    "forwarding_backend": "bpf_owned",
    "bpf_backend": "off",
    "format": "json"
  },
  "runner_boolean_flags": {
    "preview_only_no_compile": true
  },
  "allowed_capabilities": {
    "compose": false,
    "runtime": false,
    "bpf": false
  },
  "expected_outcome_labels": [
    "RICH_S4_PREVIEW_CATALOG_GATE_PASS",
    "RICH_S4_PREVIEW_CATALOG_ID_MISMATCH_STILL_PRESENT",
    "PROFILE_CONTRACT_STILL_AD_HOC"
  ],
  "forbidden_behavior": {
    "strict_bpf_owned_no_canary_experimental": false,
    "linux_gz_mpls_lfib_fallback": true,
    "canary_experimental_pass_evidence": true,
    "hidden_legacy_demo_defaults": true
  },
  "cleanup_requirements": {
    "direct_backend_host_interfaces": 0,
    "bpf_pins": 0,
    "runtime_locks": 0,
    "compose_network_residue": 0,
    "satellite_output_changed": false
  },
  "cost_sanity": {
    "startup_materialization_seconds_warn": 120,
    "preview_seconds_warn": 120,
    "unknown_blocking_seconds_warn": 30,
    "anomaly_labels": [
      "COST_SANITY_BLOCKER",
      "UNKNOWN_BLOCKING_ANOMALY"
    ]
  }
}
