{
  "schema_version": 1,
  "goal": "Audit Skyseed sampling/update pipeline before optimization",
  "date": "2026-06-21",
  "scope": {
    "audit_only": true,
    "implemented_sampling_changes": false,
    "implemented_scheduler": false,
    "changed_gz_semantics": false,
    "ran_s4_or_300_plus": false,
    "commits_satellite_output": false,
    "pushed": false
  },
  "current_model": {
    "sampling_type": "mixed_fixed_evaluation_event_driven_epochs",
    "sample_interval_semantic_truth": false,
    "ten_seconds_is_workload_input_not_invariant": true,
    "runtime_epoch_triggers": [
      "initial_runtime_epoch",
      "ut_serving_satellite_change",
      "gateway_exit_change",
      "active_link_change",
      "planner_path_change",
      "mpls_or_route_change"
    ],
    "parameter_epoch_triggers": [
      "delay_threshold_exceeded",
      "loss_threshold_exceeded",
      "bandwidth_threshold_exceeded",
      "routing_cost_changed",
      "parameter_max_interval_elapsed_when_drift_exists"
    ],
    "no_op_samples_emit_runtime_or_parameter_epoch": false,
    "horizon_replenishment_is_semantic_epoch_trigger": false
  },
  "current_defaults": {
    "run_starlink_step_seconds_default": 120.0,
    "parameter_max_interval_seconds_default": 240.0,
    "delay_threshold_ms_default": 0.5,
    "loss_threshold_pct_default": 0.02,
    "bandwidth_threshold_pct_default": 5.0,
    "routing_cost_threshold_default": 5,
    "zone_anchor_hysteresis_score_delta_default": 12.0,
    "zone_anchor_coverage_loss_margin_deg_default": 2.0,
    "zone_anchor_gateway_hop_penalty_default": 3.0
  },
  "proposed_bpf_aware_model": {
    "runtime_epoch_only_for": [
      "fec_path_change",
      "ut_serving_satellite_change",
      "zone_anchor_change",
      "gw_default_or_secondary_selection_change",
      "core_gz_path_change",
      "real_link_up_down_or_structural_change"
    ],
    "parameter_epoch_only_for": [
      "delay_threshold_or_bucket_crossing",
      "bandwidth_rate_threshold_or_bucket_crossing",
      "loss_drop_threshold_or_bucket_crossing",
      "active_inactive_transition"
    ],
    "bpf_generation_strategy": [
      "current_generation_support_now",
      "next_generation_preload_if_feasible",
      "multi_generation_horizon_preload_design_ready"
    ],
    "qdisc_owner": "linux_qdisc_remains_owner_of_delay_rate_bandwidth_queueing"
  },
  "design_only": [
    "new_scheduler",
    "changed_runtime_epoch_predicates",
    "changed_parameter_epoch_predicates",
    "minimum_dwell_time",
    "path_cost_model_using_delay_bandwidth_loss",
    "multi_generation_live_preload",
    "qdisc_backend_replacement"
  ],
  "evidence_sources": [
