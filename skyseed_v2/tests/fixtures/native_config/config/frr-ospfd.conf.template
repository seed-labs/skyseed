! Example policy: Area 0; passive GS accesses and stable identities.
hostname skyseed-ospf
log stdout
${gs_prefix_list}
${gs_edge_policy}
${passive_interfaces}
route-map IDENTITY-ADDRESSES permit 10
 match interface ${identity_interface}
!
router ospf
 ospf router-id ${identity}
 network ${identity}/32 area 0
${link_networks}
 redistribute kernel metric-type 1 route-map GS-EDGES
 redistribute connected metric-type 1 route-map IDENTITY-ADDRESSES
!
